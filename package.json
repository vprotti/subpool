{
  "name": "subpool",
  "version": "0.1.0",
  "description": "MCP server + CLI that pools several Claude Code and Codex (ChatGPT) subscriptions and routes coding tasks across them by remaining quota.",
  "type": "module",
  "license": "MIT",
  "author": "Vinicius Protti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vprotti/subpool.git"
  },
  "homepage": "https://github.com/vprotti/subpool#readme",
  "bugs": {
    "url": "https://github.com/vprotti/subpool/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "claude-code",
    "chatgpt",
    "subscription",
    "load-balancer",
    "rate-limit",
    "router"
  ],
  "bin": {
    "subpool": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
